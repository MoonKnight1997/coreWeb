# Legal Verification Protocol - Environment Variables v2.0
# Copy this file to .env and fill in your actual values

# ===========================
# Anthropic API Configuration
# ===========================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_THINKING_BUDGET=10000
ANTHROPIC_TEMPERATURE=0.2

# ===========================
# Flask Configuration
# ===========================
FLASK_SECRET_KEY=your_random_secret_key_here_change_in_production
FLASK_ENV=development

# ===========================
# Application Settings
# ===========================
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes

# ===========================
# Security Settings
# ===========================
ENABLE_SECURITY_HEADERS=true
FORCE_HTTPS=false  # Set to true in production

# ===========================
# Rate Limiting
# ===========================
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=10 per hour  # Adjust based on your needs
RATELIMIT_STORAGE_URL=memory://  # Use redis:// in production

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=console  # console or json (use json in production)

# ===========================
# Session Configuration
# ===========================
# SESSION_COOKIE_SECURE=true  # Uncomment in production
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax
